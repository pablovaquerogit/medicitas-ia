    {
      "id": 4,
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0
      },
      "filter": {
        "name": "Cita dentro de los próximos 30 minutos",
        "conditions": [
          [
            {
              "a": "{{1.`11`}}",
              "o": "text:notequal",
              "b": ""
            },
            {
              "a": "{{parseDate(1.`1` + 1.`2` + \")\"; \"\"\"YYYY-MM-DD HH:mm\"\"\")}}",
              "o": "time:greater",
              "b": "{{now}}"
            },
            {
              "a": "{{parseDate(1.`1` + 1.`2` + \")\"; \"\"\"YYYY-MM-DD HH:mm\"\"\")}}",
              "o": "time:lessorequal",
              "b": "{{addMinutes(now; 15)}}"
            }
          ]
        ]
      },
      "mapper": {
        "text": "Hola {{1.`4`}}, te recordamos que tienes una cita médica próxima.\n\nDatos de tu cita:\n\nID de cita: {{1.`0`}}\nFecha: {{1.`1`}}\nHora: {{1.`2`}}\nEspecialidad: {{1.`6`}}\nDoctor: {{1.`5`}}\n\nTe recomendamos llegar 10 minutos antes.\n\nEste es un recordatorio automático de MediCitas IA.",
        "chatId": "{{1.`11`}}",
        "parseMode": "",
        "replyMarkup": "",
        "messageThreadId": "",
        "replyToMessageId": "",
        "replyMarkupAssembleType": "reply_markup_enter"
      },
